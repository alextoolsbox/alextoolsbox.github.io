#!/bin/sh
# pre-commit: allinea il ?v= degli asset all'hash del contenuto staged.
# Copia master versionata: tools/pre-commit  (reinstalla con tools/install-hooks.sh)
# Bypass di emergenza: git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)" || exit 1
sh "$ROOT/tools/bump-assets.sh" --stage || exit 1
exit 0
