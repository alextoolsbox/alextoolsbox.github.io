#!/bin/sh
# pre-commit: allinea il ?v= degli asset all'hash del contenuto staged.
# Copia master versionata: tools/pre-commit  (reinstalla con tools/install-hooks.sh)
# Bypass di emergenza: git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)" || exit 1

# Promemoria non bloccante: l'header e' INLINE nelle pagine dal 4/9/2026.
# Se cambia includes/header.html va rilanciato tools/build_header.py,
# altrimenti le 134 pagine restano con la navbar vecchia.
if git diff --cached --name-only | grep -q '^includes/header\.html$'; then
    echo "" >&2
    echo "  >> ATTENZIONE: hai modificato includes/header.html" >&2
    echo "     L'header e' inline nelle pagine. Rilancia:" >&2
    echo "         python tools/build_header.py" >&2
    echo "     poi ri-aggiungi i file, altrimenti il sito resta con l'header vecchio." >&2
    echo "" >&2
fi

sh "$ROOT/tools/bump-assets.sh" --stage || exit 1
exit 0
